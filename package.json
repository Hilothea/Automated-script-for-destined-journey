{
  "name": "automated-script-for-destined-journey",
  "version": "3.4.1",
  "description": "命定的异世界开发之旅自动化脚本 - 用于处理角色升级、货币系统、事件链管理等游戏机制",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode production",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "jest --config ./jest.config.ts",
    "test:watch": "jest --watch --config ./jest.config.ts",
    "test:coverage": "jest --coverage --config ./jest.config.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^4.0.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^25.9.5",
    "@types/toastr": "^2.1.43",
    "compare-versions": "^6.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "klona": "^2.0.6",
    "lodash": "^4.18.1",
    "prettier": "^3.9.6",
    "terser": "^5.50.0",
    "ts-jest": "^29.4.12",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "ts-node": "^10.9.2"
  }
}